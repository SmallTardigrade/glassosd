#!/bin/bash
# SPDX-FileCopyrightText: 2026 glassosd contributors
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Command-line control for glassosd.
# Settings live in ~/.config/glassosdrc and are applied live — no restart.
#
# Everything here goes through org.glassosd.Control on the session bus, so it
# works the same on Plasma, Hyprland, sway, river or anything else with
# wlr-layer-shell. Nothing in this script needs KDE.
set -euo pipefail
RC=glassosdrc
G=Notifications
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BUS=org.glassosd.Daemon
OBJ=/Control
IFACE=org.glassosd.Control

# kreadconfig6/kwriteconfig6 are KDE tools. They are only a convenient INI
# editor here, so fall back to doing it by hand when they are absent.
have() { command -v "$1" >/dev/null 2>&1; }
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/$RC"

cfg_read() { # group key
  if have kreadconfig6; then kreadconfig6 --file "$RC" --group "$1" --key "$2" || true
  else awk -v g="[$1]" -v k="$2" '
        $0==g{ing=1;next} /^\[/{ing=0}
        ing && index($0,k"=")==1 {print substr($0,length(k)+2)}' "$CONF" 2>/dev/null
  fi
}
# cfg_read cannot fail — kreadconfig6 is wrapped in `|| true` so that a missing
# key is not an error — so `$(cfg_read ...) || echo default` never fired and
# every unset setting printed as a blank instead of as its default. Test the
# value, not the exit status.
cfg_or() { # group key default
  v=$(cfg_read "$1" "$2")
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$3"
}
cfg_write() { # group key value
  if have kwriteconfig6; then
    kwriteconfig6 --notify --file "$RC" --group "$1" --key "$2" "$3"
    return
  fi
  # No KDE, and no python either on a minimal system — edit the INI in awk.
  mkdir -p "$(dirname "$CONF")"; : >> "$CONF"
  awk -v g="[$1]" -v k="$2" -v v="$3" '
    # Blank lines at the end of a group are held back rather than printed, so
    # a new key lands against the last real entry instead of after the
    # separator. Without this the file grows a blank line on every write.
    function flush(  i) { for (i = 1; i <= nb; i++) print blanks[i]; nb = 0 }
    BEGIN { ing = 0; done = 0; any = 0; nb = 0 }
    {
      any = 1
      if ($0 == g)                       { flush(); ing = 1; print; next }
      if (ing && /^\[/) {                              # leaving the group
        if (!done) { print k "=" v; done = 1 }
        flush(); ing = 0; print; next
      }
      if (ing && index($0, k "=") == 1)  { flush(); print k "=" v; done = 1; next }
      if (ing && $0 ~ /^[[:space:]]*$/)  { blanks[++nb] = $0; next }
      flush(); print
    }
    END {
      if (ing && !done)  { print k "=" v; done = 1 }   # group ran to EOF
      flush()
      if (!done)         { if (any) print ""; print g; print k "=" v }
    }' "$CONF" > "$CONF.new" && mv "$CONF.new" "$CONF"
  # KConfigWatcher only fires for writes that emit the change signal, so a
  # hand-edited file needs a nudge.
  call Reload >/dev/null 2>&1 || true
}

call() { # Method [signature value ...]
  busctl --user call "$BUS" "$OBJ" "$IFACE" "$@" 2>/dev/null
}
running() { busctl --user status "$BUS" >/dev/null 2>&1; }

usage() {
cat <<'USAGE'
glassosdctl <command>

  status                 Show daemon state and current settings
  version                Daemon version
  get <key>              Read a Notifications setting
  set <key> <value>      Write a Notifications setting (applied immediately)

  dnd [on|off|toggle]    Do Not Disturb (no argument prints current state)
  history [show|hide]    Open/close the notification centre
  dismiss                Close every popup on screen, including ones with
                         expire_timeout 0 or critical urgency, which the spec
                         requires to stay until acted on

  osd volume [raise|lower|mute|<0-100>]
  osd mic [mute|<0-100>]
  osd brightness [raise|lower|<0-100>]
  osd text <icon> <text> Show an arbitrary OSD
                         Bind these to your compositor's media keys when you
                         are not on Plasma. On Plasma the OSD is driven
                         automatically and you do not need them.

  rules                  List notification rules
  rule-set <name> <k=v>… Create or update a rule
  rule-del <name>        Delete a rule

  theme [dark|light]     Light/dark palette (no argument prints current)
  accent [#rrggbb]       Accent colour (no argument prints current)
  level [segmented|bar]  Volume/brightness indicator style
  output [current|primary|NAME]
                         Which screen surfaces appear on
  theme-file [name]      Load a JSON theme (no argument prints current)
  themes                 List available themes and where they live
  edit-theme             Copy the current theme to ~/.config/glassosd/ and open it
  module <name> [on|off] Toggle a half of the daemon on its own:
                         notifications, centre, osd, lockkeys
  font [6-32]            Text point size. Independent of scale, which also
                         grows padding and icons; use this for bigger text in
                         the same layout. 0 or 'auto' derives it from scale.
  lines [1-20]           Body lines a popup shows before eliding (default 4)
  centre-lines [1-20]    Body lines an entry in the centre shows (default 3)
  quiet-while-busy [on|off]
                         Stay quiet while an application is holding the
                         screen awake — video, games, presentations. Off by
                         default. Not literal fullscreen: a Wayland client
                         cannot see that.
  focus [name|off]       Switch focus mode. A mode is a bundle of rules and
                         an allow/block list, on or off as a unit.
  focus-set <name> [allow=A,B] [block=C,D]
                         Define or amend a mode. allow= silences everything
                         except those apps; block= silences just those.
  focus-del <name>       Delete a mode
  search <text>          Open the centre with the history filtered to <text>
  sounds                 List every sound name your themes provide, and where
                         to put your own
  sound [on|off]         Notification sounds, by freedesktop sound-theme name
                         (on by default). Per-rule override: sound=NAME, or
                         sound=none to silence one app.
  osd-sound [on|off]     Feedback on volume steps and lock keys (off by
                         default — a click on every keypress is a taste).
  snooze [minutes]       How long the snooze button defers a notification
                         (default 10). The card closes and comes back later.
  snoozed                List what is snoozed and when each is due
  badge [on|off]         Mark the tray icon when notifications arrived while
                         the centre was closed. Uses the icon theme's own
                         active-notification icon; the count is in the tooltip,
                         because no icon theme ships numerals.
  position [where]       Which corner or edge popups appear at:
                         top-left, top-centre, top-right (default),
                         bottom-left, bottom-centre, bottom-right.
  offset [X] [Y]         Extra clearance from the anchored screen edges, in
                         logical px. 0 is not flush — the shadow already
                         insets the cards. Use it to clear something with no
                         exclusive zone of its own, such as a browser's tab
                         strip. One number sets both.
  centre-position [l|r]  Which side the notification centre slides in from
  osd-position [where]   top (default), centre or bottom
  widgets [list]         Which widgets the centre shows, and in what order.
                         Comma-separated, swaync's names: title, mpris, volume,
                         dnd, notifications, backlight, buttons-grid. A list
                         that does not name 'notifications' is read as a plain
                         set in the built-in order, because that is what this
                         key used to mean. 'default' restores the full order.
                             glassosdctl widgets title,notifications,dnd
  scale [0.6-2.0]        Size multiplier for all text and spacing
  width [240-900]        Notification popup width in logical px
  solidity [0.0-1.0]     Push glass toward opaque. 0 keeps the tuned glass;
                         raise it on compositors that do not blur (sway, river)
  layer [top|overlay]    Where popups sit relative to fullscreen windows.
                         top (default) stays below them; overlay covers them.
                         No layer exists in between — fullscreen sits exactly
                         there. Neither survives KWin's Show Desktop, which
                         hides every layer-shell surface regardless.
  blur [auto|on|off]     Whether the compositor can blur behind us. auto
                         assumes yes on Wayland; set off on sway/river/labwc,
                         which have no blur and would render unreadable glass

  test                   Fire the full demo sequence
  restart                Restart the daemon
  log                    Follow the daemon log

Settings keys:  Enabled, Limit, IndicateHidden, CoalesceThreshold,
                CoalesceWindowMs, DoNotDisturb, AutoCollapseOver,
                HistoryLength, IdleThresholdMs, HoverPause, NewestFirst,
                Timeout, TimeoutLow, TimeoutCritical

How long popups stay (ms; 0 = until dismissed). An app's own
expire_timeout still wins; these apply when it sends -1:
    glassosdctl set Timeout 12000        # normal urgency, default 6000
    glassosdctl set TimeoutLow 8000      # low, default 4000
    glassosdctl set TimeoutCritical 0    # critical, default 0 = never
Rule keys:      appname, summary, body, category, desktop_entry,
                match_urgency, focus, set_stack_tag, timeout, set_urgency,
                skip_display, history_ignore, always_collapsed, sound,
                run, snooze, repeat_window

The centre's per-app settings panel writes these same rules:
    Mute             skip_display=true
    Ignore           history_ignore=true skip_display=true
    Never expire     timeout=0
    Always collapsed always_collapsed=true
USAGE
}

# ---- volume/brightness helpers, only used by the `osd` subcommand ----------

vol_get() {
  if have wpctl; then
    wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null \
      | awk '{ v=$2*100; if ($3=="[MUTED]") v=0; printf "%d", v+0.5 }'
  elif have pactl; then
    if [ "$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')" = yes ]; then echo 0
    else pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1; fi
  else echo 0; fi
}
vol_set() { # raise|lower|mute|N
  if have wpctl; then
    case "$1" in
      raise) wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
      lower) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
      mute)  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
      *)     wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ "$1%" ;;
    esac
  elif have pactl; then
    case "$1" in
      raise) pactl set-sink-mute @DEFAULT_SINK@ 0; pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
      lower) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
      mute)  pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
      *)     pactl set-sink-mute @DEFAULT_SINK@ 0; pactl set-sink-volume @DEFAULT_SINK@ "$1%" ;;
    esac
  else echo "no wpctl or pactl found" >&2; exit 1; fi
}
mic_get() {
  have wpctl && wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null \
    | awk '{ v=$2*100; if ($3=="[MUTED]") v=0; printf "%d", v+0.5 }' && return
  echo 0
}
mic_set() {
  have wpctl || { echo "no wpctl found" >&2; exit 1; }
  case "$1" in
    mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    *)    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0; wpctl set-volume @DEFAULT_AUDIO_SOURCE@ "$1%" ;;
  esac
}
bri_get() {
  have brightnessctl && echo $(( $(brightnessctl g) * 100 / $(brightnessctl m) )) && return
  echo 0
}
bri_set() {
  have brightnessctl || { echo "brightnessctl not found" >&2; exit 1; }
  case "$1" in
    raise) brightnessctl -q set 5%+ ;;
    lower) brightnessctl -q set 5%- ;;
    *)     brightnessctl -q set "$1%" ;;
  esac
}

outputs() {
  if have kscreen-doctor; then
    kscreen-doctor -o 2>/dev/null | grep -oE '^Output: [0-9]+ [A-Za-z0-9-]+' | awk '{print "  "$3}'
  elif have hyprctl; then
    hyprctl monitors -j 2>/dev/null | grep -oP '"name":\s*"\K[^"]+' | sed 's/^/  /'
  elif have wlr-randr; then
    wlr-randr 2>/dev/null | grep -oE '^[A-Za-z0-9-]+' | sed 's/^/  /'
  else echo "  (no kscreen-doctor, hyprctl or wlr-randr found)"; fi
}

cmd=${1:-status}; shift || true
case "$cmd" in
  status)
    if have systemctl; then printf 'daemon:        %s\n' "$(systemctl --user is-active glassosd.service 2>/dev/null || echo unknown)"; fi
    printf 'control bus:   %s\n' "$(running && echo 'org.glassosd.Daemon (up)' || echo 'not responding')"
    owner=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null | awk '{print $2}')
    printf 'notifications: owned by %s\n' "$(ps -o comm= -p "${owner:-0}" 2>/dev/null || echo 'nobody')"
    echo
    # "key<TAB>default" — status printed a blank for anything the user had not
    # explicitly set, which reads as "unset and therefore off" when in fact
    # every one of these has a working default. Show the default, and say so.
    echo "settings:"
    printf '%s\n' \
      "Enabled|true" "Limit|4" "IndicateHidden|true" "CoalesceThreshold|3" \
      "CoalesceWindowMs|20000" "DoNotDisturb|false" "AutoCollapseOver|3" \
      "HistoryLength|200" "IdleThresholdMs|120000" "HoverPause|true" \
    | while IFS='|' read -r k d; do
        v=$(cfg_read $G "$k")
        if [ -n "$v" ]; then printf '  %-18s %s\n' "$k" "$v"
        else printf '  %-18s %s (default)\n' "$k" "$d"; fi
      done
    echo
    echo "appearance:"
    printf '%s\n' \
      "Theme|dark" "ThemeFile|(built-in)" "AccentColor|#3daee9" \
      "LevelStyle|segmented" "Output|current" "Scale|1.0" \
      "FontSize|auto (from scale)" "BodyLines|4" "CentreBodyLines|3" \
      "NotifyWidth|380" "Solidity|0.0" "Blur|auto" "NotifyLayer|top" \
      "NotifyPosition|top-right" "NotifyMarginX|0" "NotifyMarginY|0" \
      "CentrePosition|right" "OsdPosition|top" \
      "Widgets|title,mpris,volume,dnd,notifications,backlight,buttons-grid" \
    | while IFS='|' read -r k d; do
        v=$(cfg_read Appearance "$k")
        if [ -n "$v" ]; then printf '  %-18s %s\n' "$k" "$v"
        else printf '  %-18s %s (default)\n' "$k" "$d"; fi
      done
    echo
    echo "modules:"
    for k in Notifications NotificationCentre Osd LockKeys; do
      printf '  %-18s %s\n' "$k" "$(cfg_or Modules "$k" true)"
    done
    echo
    echo "rules:"
    grep -o '^\[Rule .*\]$' "$CONF" 2>/dev/null | sed 's/^\[Rule /  /; s/\]$//' || echo "  (none)"
    ;;
  version)
    running || { echo "daemon not running" >&2; exit 1; }
    call Version | sed 's/^s //; s/"//g' ;;
  get) cfg_read $G "$1" ;;
  set)
    # Warn on a key the daemon does not read, but write it anyway.
    #
    # cfg_write takes anything, so `set Limitt 5` reported "applied live" and
    # wrote a key nothing ever reads — a confident success message for a
    # setting that does nothing. Rejecting unknown keys would be worse: this
    # CLI has already shipped a whitelist that turned away a key the daemon
    # had grown, so the list is a hint, not an authority.
    case " Enabled Limit IndicateHidden CoalesceThreshold CoalesceWindowMs \
DoNotDisturb AutoCollapseOver HistoryLength IdleThresholdMs HoverPause \
NewestFirst Timeout TimeoutLow TimeoutCritical " in
      *" $1 "*) ;;
      *) echo "warning: '$1' is not a setting glassosd reads; writing it anyway" >&2 ;;
    esac
    cfg_write $G "$1" "$2"; echo "$1 = $2 (applied live)" ;;
  dnd)
    case "${1:-}" in
      on)     call SetDoNotDisturb b true  >/dev/null; echo "DND on" ;;
      off)    call SetDoNotDisturb b false >/dev/null; echo "DND off" ;;
      toggle) call ToggleDoNotDisturb | grep -q true && echo "DND on" || echo "DND off" ;;
      "")     call DoNotDisturb | grep -q true && echo "DND: on" || echo "DND: off" ;;
      *)      echo "usage: glassosdctl dnd [on|off|toggle]" >&2; exit 1 ;;
    esac ;;
  dismiss)
    n=$(call DismissAll | awk '{print $2}')
    echo "dismissed ${n:-0} notification(s)" ;;
  history)
    case "${1:-}" in
      show) call ShowHistory   >/dev/null ;;
      hide) call HideHistory   >/dev/null ;;
      *)    call ToggleHistory >/dev/null ;;
    esac ;;
  osd)
    kind=${1:-}; arg=${2:-}
    case "$kind" in
      volume)     vol_set "${arg:-raise}"; call VolumeChanged ii "$(vol_get)" 100 >/dev/null ;;
      mic)        mic_set "${arg:-mute}";  call MicrophoneVolumeChanged i "$(mic_get)" >/dev/null ;;
      brightness) bri_set "${arg:-raise}"; call BrightnessChanged i "$(bri_get)" >/dev/null ;;
      text)       call ShowText ss "${2:-}" "${3:-}" >/dev/null ;;
      *) echo "usage: glassosdctl osd volume|mic|brightness|text …" >&2; exit 1 ;;
    esac ;;
  rules)
    if grep -q '^\[Rule ' "$CONF" 2>/dev/null; then
      # n is cleared at any other section header, not a separate flag: the old
      # version set inr=0 while still testing n, so once it had seen one rule
      # it went on printing every line of the file that followed.
      awk '/^\[Rule /{n=$0; sub(/^\[Rule /,"",n); sub(/\]$/,"",n); print "\n" n ":"; next}
           /^\[/{n=""} NF && n {print "  " $0}' "$CONF"
    else echo "(no rules)"; fi ;;
  rule-set)
    name=$1; shift
    for kv in "$@"; do cfg_write "Rule $name" "${kv%%=*}" "${kv#*=}"; done
    echo "rule '$name' saved (applied live)" ;;
  rule-del)
    # kwriteconfig6 has no --delete-group, so the section goes out of the INI
    # here. It used to be asked for one anyway and reported success while
    # deleting nothing.
    grep -q "^\[Rule $1\]$" "$CONF" 2>/dev/null || { echo "no rule '$1'" >&2; exit 1; }
    tmp=$(mktemp)
    awk -v want="[Rule $1]" '
      $0 == want { drop = 1; next }
      /^\[/      { drop = 0 }
      !drop      { print }' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
    # The file was edited behind KConfig's back, so nothing has told the daemon.
    # Rewriting a key it already has, with --notify, is what makes it reload.
    if have kwriteconfig6; then
      kwriteconfig6 --notify --file "$RC" --group Notifications --key Enabled \
        "$(cfg_or Notifications Enabled true)"
    fi
    echo "rule '$1' deleted" ;;
  themes)
    echo "search path (first match wins):"
    for d in "${XDG_CONFIG_HOME:-$HOME/.config}/glassosd/themes" \
             "$HOME/.local/share/glassosd/themes" /usr/share/glassosd/themes; do
      [ -d "$d" ] || continue
      echo "  $d"
      for f in "$d"/*.json; do [ -e "$f" ] && echo "      $(basename "${f%.json}")"; done
    done
    echo
    echo "current: $(cfg_or Appearance ThemeFile '(built-in)')" ;;
  theme-file)
    case "${1:-}" in
      "")     echo "theme-file: $(cfg_or Appearance ThemeFile '(built-in)')" ;;
      none|default|reset)
        # Deleting the key rather than blanking it: an empty value still
        # counts as "set" to some INI readers, and a theme file that was
        # renamed or removed would otherwise keep being looked up and keep
        # logging a load failure on every reload.
        if have kwriteconfig6; then
          kwriteconfig6 --notify --file $RC --group Appearance --key ThemeFile --delete
        else cfg_write Appearance ThemeFile ""; fi
        echo "theme-file = (built-in)" ;;
      *)      cfg_write Appearance ThemeFile "$1"; echo "theme-file = $1" ;;
    esac ;;
  edit-theme)
    dest="${XDG_CONFIG_HOME:-$HOME/.config}/glassosd/themes"
    mkdir -p "$dest"
    cur=$(cfg_or Appearance ThemeFile glass-dark)
    [ -n "$cur" ] || cur=glass-dark
    if [ ! -f "$dest/$cur.json" ]; then
      for d in "$HOME/.local/share/glassosd/themes" /usr/share/glassosd/themes "$SELF_DIR/../themes"; do
        [ -f "$d/$cur.json" ] && cp "$d/$cur.json" "$dest/$cur.json" && break
      done
    fi
    [ -f "$dest/$cur.json" ] || { echo "no theme '''$cur''' found to copy" >&2; exit 1; }
    cfg_write Appearance ThemeFile "$cur"
    echo "editing $dest/$cur.json (saves apply live)"
    exec "${VISUAL:-${EDITOR:-nano}}" "$dest/$cur.json" ;;
  module)
    name=${1:-}; val=${2:-}
    case "$name" in
      notifications) key=Notifications ;;
      centre|center) key=NotificationCentre ;;
      osd)           key=Osd ;;
      lockkeys)      key=LockKeys ;;
      "")  echo "modules:"
           for k in Notifications NotificationCentre Osd LockKeys; do
             printf '''  %-20s %s\n''' "$k" "$(cfg_or Modules "$k" true)"
           done
           exit 0 ;;
      *)   echo "unknown module: $name (notifications, centre, osd, lockkeys)" >&2; exit 1 ;;
    esac
    if [ -z "$val" ]; then echo "$key: $(cfg_or Modules "$key" true)"
    else
      case "$val" in on|true) v=true ;; off|false) v=false ;; *) echo "use on or off" >&2; exit 1 ;; esac
      cfg_write Modules "$key" "$v"
      echo "$key = $v"
      echo "modules are read at startup — run: glassosdctl restart"
    fi ;;
  theme)
    case "${1:-}" in
      dark|light) cfg_write Appearance Theme "$1"; echo "theme = $1" ;;
      "")  echo "theme: $(cfg_or Appearance Theme dark)" ;;
      *)   echo "usage: glassosdctl theme [dark|light]" >&2; exit 1 ;;
    esac ;;
  accent)
    if [ -z "${1:-}" ]; then
      echo "accent: $(cfg_or Appearance AccentColor '#3daee9')"
    else
      case "$1" in
        \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*) ;;
        *) echo "accent must be a hex colour, e.g. #d95f02" >&2; exit 1 ;;
      esac
      cfg_write Appearance AccentColor "$1"; echo "accent = $1"
    fi ;;
  layer)
    case "${1:-}" in
      top|overlay) cfg_write Appearance NotifyLayer "$1"; echo "layer = $1"
                   echo "run: glassosdctl restart" ;;
      "")  echo "layer: $(cfg_or Appearance NotifyLayer top)" ;;
      *)   echo "usage: glassosdctl layer [top|overlay]" >&2; exit 1 ;;
    esac ;;
  blur)
    case "${1:-}" in
      auto|on|off) cfg_write Appearance Blur "$1"; echo "blur = $1"
                   echo "blur is read at startup — run: glassosdctl restart" ;;
      "")  echo "blur: $(cfg_or Appearance Blur auto)" ;;
      *)   echo "usage: glassosdctl blur [auto|on|off]" >&2; exit 1 ;;
    esac ;;
  solidity)
    if [ -z "${1:-}" ]; then echo "solidity: $(cfg_or Appearance Solidity 0.0)"
    else cfg_write Appearance Solidity "$1"; echo "solidity = $1"; fi ;;
  font)
    case "${1:-}" in
      "")        echo "font: $(cfg_or Appearance FontSize 'auto (from scale)')" ;;
      auto|0)    cfg_write Appearance FontSize 0; echo "font = auto (from scale)" ;;
      *)         cfg_write Appearance FontSize "$1"; echo "font = $1" ;;
    esac ;;
  lines)
    if [ -z "${1:-}" ]; then echo "lines: $(cfg_or Appearance BodyLines 4)"
    else cfg_write Appearance BodyLines "$1"; echo "lines = $1"; fi ;;
  centre-lines|center-lines)
    if [ -z "${1:-}" ]; then echo "centre-lines: $(cfg_or Appearance CentreBodyLines 3)"
    else cfg_write Appearance CentreBodyLines "$1"; echo "centre-lines = $1"; fi ;;
  quiet-while-busy)
    case "${1:-}" in
      "")        echo "quiet-while-busy: $(cfg_or Notifications QuietWhileBusy false)" ;;
      on|true)   cfg_write Notifications QuietWhileBusy true;  echo "quiet-while-busy = on" ;;
      off|false) cfg_write Notifications QuietWhileBusy false; echo "quiet-while-busy = off" ;;
      *) echo "quiet-while-busy takes 'on' or 'off'" >&2; exit 1 ;;
    esac ;;
  focus)
    cur=$(cfg_or Notifications Focus "")
    case "${1:-}" in
      "")
        echo "focus: ${cur:-off}"
        modes=$(grep -o '^\[Focus .*\]$' "$CONF" 2>/dev/null | sed 's/^\[Focus //; s/\]$//' | sort)
        [ -n "$modes" ] && { echo "  defined: $(echo "$modes" | tr '\n' ' ')"; } \
                        || echo "  (no modes defined — see 'focus-set')" ;;
      off|none)
        cfg_write Notifications Focus ""; echo "focus off" ;;
      *)
        grep -q "^\[Focus $1\]$" "$CONF" 2>/dev/null \
          || { echo "no focus mode '$1'; define one with: glassosdctl focus-set $1 allow=App,App" >&2; exit 1; }
        cfg_write Notifications Focus "$1"; echo "focus = $1" ;;
    esac ;;
  focus-set)
    name=$1; shift
    [ -n "$name" ] || { echo "usage: glassosdctl focus-set <name> [allow=A,B] [block=C,D]" >&2; exit 1; }
    for kv in "$@"; do
      k=${kv%%=*}; v=${kv#*=}
      case "$k" in
        allow|Allow) cfg_write "Focus $name" Allow "$v" ;;
        block|Block) cfg_write "Focus $name" Block "$v" ;;
        *) echo "focus-set takes allow= and block=, not '$k'" >&2; exit 1 ;;
      esac
    done
    echo "focus mode '$name' saved" ;;
  focus-del)
    [ -n "${1:-}" ] || { echo "usage: glassosdctl focus-del <name>" >&2; exit 1; }
    grep -q "^\[Focus $1\]$" "$CONF" 2>/dev/null || { echo "no focus mode '$1'" >&2; exit 1; }
    tmp=$(mktemp)
    awk -v want="[Focus $1]" '$0 == want { drop=1; next } /^\[/ { drop=0 } !drop { print }' \
      "$CONF" > "$tmp" && mv "$tmp" "$CONF"
    [ "$(cfg_or Notifications Focus "")" = "$1" ] && cfg_write Notifications Focus ""
    if have kwriteconfig6; then
      kwriteconfig6 --notify --file "$RC" --group Notifications --key Enabled \
        "$(cfg_or Notifications Enabled true)"
    fi
    echo "focus mode '$1' deleted" ;;
  search)
    [ -n "${1:-}" ] || { echo "usage: glassosdctl search <text>" >&2; exit 1; }
    call Search s "$*" >/dev/null && echo "searching history for: $*" ;;
  sounds)
    # An unset key reads as empty with exit 0, so the fallback has to test the
    # value rather than the status — the same trap cfg_or exists for.
    theme=$(kreadconfig6 --file kdeglobals --group Sounds --key Theme 2>/dev/null)
    echo "sound theme in use: ${theme:-freedesktop (default)}"
    echo
    echo "names your themes provide (any of these works as sound=NAME):"
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}/sounds" /usr/share/sounds; do
      [ -d "$d" ] || continue
      for t in "$d"/*/; do
        [ -d "$t" ] || continue
        names=$(find "$t" \( -name '*.oga' -o -name '*.ogg' -o -name '*.wav' \) -printf '%f\n' 2>/dev/null \
                | sed 's/\.\(oga\|ogg\|wav\)$//' | sort -u)
        [ -n "$names" ] || continue
        printf '\n  [%s]\n' "$(basename "$t")"
        echo "$names" | tr '\n' ' ' | fold -s -w 74 | sed 's/^/    /'
      done
    done
    echo
    echo "custom: put a file at ~/.local/share/sounds/<theme>/stereo/<name>.oga"
    echo "        or point a rule straight at one: sound=/path/to/ding.ogg" ;;
  sound)
    case "${1:-}" in
      "")      echo "sound: $(cfg_or Sounds Enabled true)  (osd: $(cfg_or Sounds Osd false))" ;;
      on|true)   cfg_write Sounds Enabled true;  echo "sound = on" ;;
      off|false) cfg_write Sounds Enabled false; echo "sound = off" ;;
      *) echo "sound takes 'on' or 'off'" >&2; exit 1 ;;
    esac ;;
  osd-sound)
    case "${1:-}" in
      "")      echo "osd-sound: $(cfg_or Sounds Osd false)" ;;
      on|true)   cfg_write Sounds Osd true;  echo "osd-sound = on" ;;
      off|false) cfg_write Sounds Osd false; echo "osd-sound = off" ;;
      *) echo "osd-sound takes 'on' or 'off'" >&2; exit 1 ;;
    esac ;;
  snooze)
    if [ -z "${1:-}" ]; then echo "snooze: $(cfg_or Notifications SnoozeMinutes 10) minutes"
    else cfg_write Notifications SnoozeMinutes "$1"; echo "snooze = $1 minutes"; fi ;;
  snoozed)
    f="${XDG_DATA_HOME:-$HOME/.local/share}/glassosd/snoozed.json"
    if [ ! -s "$f" ] || [ "$(cat "$f")" = "[]" ]; then echo "nothing snoozed"; exit 0; fi
    have python3 || { echo "  (needs python3 to format; the file is $f)"; exit 0; }
    python3 - "$f" <<'SNZ'
import json, sys, datetime
for e in json.load(open(sys.argv[1])):
    raw = e.get("wakeAt", "")
    try:
        t = datetime.datetime.fromisoformat(raw.replace("Z", "+00:00")).astimezone()
        mins = int((t - datetime.datetime.now().astimezone()).total_seconds() // 60)
        when = t.strftime("%H:%M") + (" (in %dm)" % mins if mins >= 0 else " (due)")
    except Exception:
        when = raw
    print("  %-18s %-34s %s" % (e.get("app", "?")[:18], e.get("summary", "")[:34], when))
SNZ
    ;;
  badge)
    case "${1:-}" in
      "")              echo "badge: $(cfg_or Appearance TrayBadge on)" ;;
      on|off)          cfg_write Appearance TrayBadge "$1"; echo "badge = $1" ;;
      *) echo "badge takes 'on' or 'off'" >&2; exit 1 ;;
    esac ;;
  position)
    known="top-left top-centre top-right bottom-left bottom-centre bottom-right"
    if [ -z "${1:-}" ]; then
      echo "position: $(cfg_or Appearance NotifyPosition top-right)"
      echo "  known:  $known"
      echo "  offset: x=$(cfg_or Appearance NotifyMarginX 0) y=$(cfg_or Appearance NotifyMarginY 0)"
    else
      # US spelling in, UK spelling stored; the daemon accepts either, but
      # keeping one form in the file means `position` reads back what you typed.
      want=$(echo "$1" | sed 's/center/centre/')
      case " $known " in
        *" $want "*) cfg_write Appearance NotifyPosition "$want"; echo "position = $want" ;;
        *) echo "unknown position '$1'; known: $known" >&2; exit 1 ;;
      esac
    fi ;;
  offset)
    if [ -z "${1:-}" ]; then
      echo "offset: x=$(cfg_or Appearance NotifyMarginX 0) y=$(cfg_or Appearance NotifyMarginY 0)"
    else
      cfg_write Appearance NotifyMarginX "$1"
      cfg_write Appearance NotifyMarginY "${2:-$1}"
      echo "offset = x=$1 y=${2:-$1}"
    fi ;;
  centre-position|center-position)
    case "${1:-}" in
      "")         echo "centre-position: $(cfg_or Appearance CentrePosition right)" ;;
      left|right) cfg_write Appearance CentrePosition "$1"; echo "centre-position = $1" ;;
      *)          echo "centre-position takes 'left' or 'right'" >&2; exit 1 ;;
    esac ;;
  osd-position)
    case "${1:-}" in
      "")                    echo "osd-position: $(cfg_or Appearance OsdPosition top)" ;;
      top|bottom)            cfg_write Appearance OsdPosition "$1"; echo "osd-position = $1" ;;
      centre|center)         cfg_write Appearance OsdPosition centre; echo "osd-position = centre" ;;
      *) echo "osd-position takes 'top', 'centre' or 'bottom'" >&2; exit 1 ;;
    esac ;;
  widgets)
    known="title mpris volume dnd search notifications backlight buttons-grid"
    case "${1:-}" in
      "")
        cur=$(cfg_or Appearance Widgets "$(echo "$known" | tr ' ' ,)")
        echo "widgets: $cur"
        case ",$cur," in
          *,notifications,*) echo "  (an order — the centre lays them out like this)" ;;
          *) echo "  (a set — add 'notifications' to control the order)" ;;
        esac
        echo "  known:   $known" ;;
      default|reset)
        cfg_write Appearance Widgets "$(echo "$known" | tr ' ' ,)"
        echo "widgets = $(echo "$known" | tr ' ' ,)" ;;
      *)
        # Reject a typo here rather than let it vanish silently in the daemon.
        for w in $(echo "$1" | tr , ' '); do
          case " $known " in
            *" $w "*) ;;
            *) echo "unknown widget '$w'; known: $known" >&2; exit 1 ;;
          esac
        done
        case ",$1," in
          *,notifications,*) ;;
          *) echo "note: no 'notifications' in the list, so it is read as a set" >&2 ;;
        esac
        cfg_write Appearance Widgets "$1"; echo "widgets = $1" ;;
    esac ;;
  scale)
    if [ -z "${1:-}" ]; then echo "scale: $(cfg_or Appearance Scale 1.0)"
    else cfg_write Appearance Scale "$1"; echo "scale = $1"; fi ;;
  width)
    if [ -z "${1:-}" ]; then echo "width: $(cfg_or Appearance NotifyWidth 380)"
    else cfg_write Appearance NotifyWidth "$1"; echo "width = $1"; fi ;;
  output)
    if [ -z "${1:-}" ]; then
      echo "output: $(cfg_or Appearance Output current)"
      echo "available:"; outputs
    else cfg_write Appearance Output "$1"; echo "output = $1"; fi ;;
  level)
    case "${1:-}" in
      segmented|bar) cfg_write Appearance LevelStyle "$1"; echo "level = $1" ;;
      "")  echo "level: $(cfg_or Appearance LevelStyle segmented)" ;;
      *)   echo "usage: glassosdctl level [segmented|bar]" >&2; exit 1 ;;
    esac ;;
  test)
    if [ -x "$SELF_DIR/demo-notifications.sh" ]; then exec "$SELF_DIR/demo-notifications.sh"
    elif [ -x /usr/share/glassosd/demo-notifications.sh ]; then exec /usr/share/glassosd/demo-notifications.sh
    else echo "demo script not found" >&2; exit 1; fi ;;
  restart) systemctl --user restart glassosd.service; echo "restarted" ;;
  log) exec journalctl --user -u glassosd -f ;;
  -h|--help|help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
