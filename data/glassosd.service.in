[Unit]
Description=glassosd — glass notification daemon and OSD
Documentation=https://github.com/SmallTardigrade/glassosd
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/glassosd
Restart=on-failure
# Exit 0 when there is no display; never restart-loop into a teardown.
RestartPreventExitStatus=0
RestartSec=2
Slice=background.slice

[Install]
WantedBy=graphical-session.target
