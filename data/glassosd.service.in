[Unit]
Description=glassosd — glass notification daemon and OSD
Documentation=https://github.com/glassosd/glassosd
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/glassosd
Restart=on-failure
RestartSec=2
Slice=background.slice

[Install]
WantedBy=graphical-session.target
